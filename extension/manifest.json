{
  "manifest_version": 3,
  "name": "PhishGuard AI - Link Scanner",
  "version": "1.0.0",
  "description": "Real-time AI Phishing & Malicious Website Detection for active tabs and URLs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Page with PhishGuard AI"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
